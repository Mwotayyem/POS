<Project Sdk="Microsoft.NET.Sdk">

  <!-- Persistence: الوصول للبيانات (EF Core + SQL Server) — DbContext لاحقاً في Phase 2 -->
  <ItemGroup>
    <ProjectReference Include="..\SmartApp.Application\SmartApp.Application.csproj" />
    <ProjectReference Include="..\SmartApp.Domain\SmartApp.Domain.csproj" />
    <ProjectReference Include="..\SmartApp.Shared\SmartApp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <!-- Design: needed at compile time for IDesignTimeDbContextFactory and at design time
         for migrations tooling. PrivateAssets=all keeps it from flowing to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
