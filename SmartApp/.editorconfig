# SmartApp — معايير التنسيق الموحّدة (تلتزم بـ 13-Development-Rules.md §7 Naming)
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
tab_width = 4

# ترتيب الـ using وتنظيمها
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# تفضيلات صياغة C#
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
# 'always' but interface members are implicitly public — exclude them so IDE0040
# does not flag interface property/method declarations.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# قواعد التسمية (Naming) — PascalCase / camelCase / _camelCase / I-prefix
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_style
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

[*.{json,yml,yaml,props,targets,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ===== Generated EF Core migrations — exempt from style analysis =====
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ===== Test projects — allow underscores in test method names (Given_When_Then) =====
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# ===== CA1716: 'Shared' namespace is intentional (project name); C#-only solution =====
[*.cs]
dotnet_diagnostic.CA1716.severity = none

# ===== CA1711: 'Permission'/'RolePermission' are the authoritative domain entity names =====
dotnet_diagnostic.CA1711.severity = none
